\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.3.2}语义边际 BPR（HardBPR-Margin）}{4}{subsubsection.3.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces HardBPR 的训练流程。模型前向传播（ID 嵌入 $\to $ 图传播 $\to $ 内积预测）与标准 LightGCN 完全相同。唯一改动在损失层（红色虚线框）：利用冻结的 LLM 语义嵌入计算正负样本对之间的语义相似度，并据此重分配 BPR 权重。}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:framework}{{2}{4}{HardBPR 的训练流程。模型前向传播（ID 嵌入 $\to $ 图传播 $\to $ 内积预测）与标准 LightGCN 完全相同。唯一改动在损失层（红色虚线框）：利用冻结的 LLM 语义嵌入计算正负样本对之间的语义相似度，并据此重分配 BPR 权重。}{figure.2}{}}
